# Local development (app running on the host, database from docker compose)
DATABASE_URL="postgresql://pastel:pastel@localhost:5432/pastel_shop?schema=public"

# Base URL used in Stripe redirect URLs
APP_URL="http://localhost:3000"

# Set to "false" to make /admin return 404
ADMIN_ENABLED="true"

# Optional. If set, /admin/login asks for this password before signing in.
# Leave empty for one-click demo login.
ADMIN_PASSWORD=""

# Optional. Signs the admin session cookie. Set a random value in production.
ADMIN_SESSION_SECRET=""

# Optional. Leave empty to use the built-in demo checkout (no money, no network).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
